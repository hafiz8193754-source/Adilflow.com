# Contact form (Resend). Set real values in Vercel only — never commit them.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Demo chatbot at POST /api/chat. Server-only — never expose this to the browser.
# On Vercel, AI Gateway can authenticate with OIDC (VERCEL_OIDC_TOKEN is injected).
# For local dev, set an AI Gateway API key. One of the two is enough.
# Model id lives in src/lib/ai/config.ts (CHAT_MODEL).
AI_GATEWAY_API_KEY=
