# Contact form (Resend). Set real values in Vercel only — never commit them.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Demo chatbot at POST /api/chat. Server-only — never expose this to the browser.
# Primary: a free-tier key from Google AI Studio (https://aistudio.google.com/apikey).
# New keys may start with AQ. rather than AIza. The SDK sends the value as-is.
# Model id lives in src/lib/ai/config.ts (CHAT_MODEL = gemini-3.5-flash-lite).
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional fallback, used only when GOOGLE_GENERATIVE_AI_API_KEY is unset.
# Vercel AI Gateway needs a credit card on the team, so OIDC alone is not used.
AI_GATEWAY_API_KEY=
