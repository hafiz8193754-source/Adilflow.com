{
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "adilflow.com"
        }
      ],
      "destination": "https://www.adilflow.com/",
      "permanent": true
    },
    {
      "source": "/portfolio/:slug/",
      "destination": "https://www.adilflow.com/portfolio",
      "permanent": true
    },
    {
      "source": "/portfolio/:slug",
      "destination": "https://www.adilflow.com/portfolio",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "https://www.adilflow.com/privacy-policy",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html/",
      "destination": "https://www.adilflow.com/privacy-policy",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "https://www.adilflow.com/about",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "https://www.adilflow.com/contact",
      "permanent": true
    },
    {
      "source": "/pricing/",
      "destination": "https://www.adilflow.com/pricing",
      "permanent": true
    },
    {
      "source": "/portfolio/",
      "destination": "https://www.adilflow.com/portfolio",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "https://www.adilflow.com/services",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "https://www.adilflow.com/blog",
      "permanent": true
    },
    {
      "source": "/privacy-policy/",
      "destination": "https://www.adilflow.com/privacy-policy",
      "permanent": true
    },
    {
      "source": "/:path(.+)/",
      "destination": "https://www.adilflow.com/:path",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "adilflow.com"
        }
      ],
      "destination": "https://www.adilflow.com/:path*",
      "permanent": true
    }
  ]
}
